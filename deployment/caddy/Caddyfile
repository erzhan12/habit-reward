# Day Forge App - Subdomain
dayforge.habitreward.org {
    # Automatic HTTPS via Let's Encrypt
    tls erzhan.sarsenov@gmail.com

    encode zstd gzip

    # Django trusts this via SECURE_PROXY_SSL_HEADER (settings.py).
    # No active health check by design — the active check caused sitewide 503
    # via SQLite lock contention (commit cd1d293). Do not re-add health_uri here.
    reverse_proxy host.docker.internal:8006 {
        header_up X-Forwarded-Proto https
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/dayforge-access.log
        format console
    }

    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}"
    }
}

# Progrev Stories App - Subdomain
progrevstories.habitreward.org {
    # Automatic HTTPS via Let's Encrypt
    tls erzhan.sarsenov@gmail.com

    encode zstd gzip

    # Reverse proxy to FastAPI app on host (SQLite-backed).
    # No active health check by design — this app is SQLite-backed and the
    # active check causes sitewide 503 via lock contention (same as dayforge,
    # commit cd1d293). Do not re-add health_uri here.
    reverse_proxy host.docker.internal:8007 {
        header_up X-Forwarded-Proto https
    }

    # Security headers (same as main app)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    log {
        output file /var/log/caddy/progrevstories-access.log
        format console
    }
    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}"
    }
}

# Lexi App - Subdomain
lexi.habitreward.org {
    # Automatic HTTPS via Let's Encrypt
    tls erzhan.sarsenov@gmail.com

    encode zstd gzip

    # Django app (SQLite-backed). Trusts HTTPS via SECURE_PROXY_SSL_HEADER (config/settings.py).
    # No active health check by design — same rationale as dayforge (commit cd1d293).
    reverse_proxy host.docker.internal:8008 {
        header_up X-Forwarded-Proto https
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/lexi-access.log
        format console
    }

    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}"
    }
}

# Redirect www to non-www (if needed)
www.habitreward.org {
    redir https://habitreward.org{uri} permanent
}

# Catch-all: Block all other domains and direct IP access
# This must come AFTER specific domain blocks
:80, :443 {
    respond "Domain not configured" 444

    log {
        output file /var/log/caddy/blocked.log
        format console
    }
}
